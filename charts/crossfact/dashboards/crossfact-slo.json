     "text": "Prometheus",
     "value": "prometheus"
    }
   },
   {
    "name": "namespace",
    "type": "custom",
    "query": "crossfact",
    "label": "Namespace",
    "current": {
     "text": "crossfact",
     "value": "crossfact"
    },
    "hide": 2
   }
  ]
 },
